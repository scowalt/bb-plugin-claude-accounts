{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "host.ts",
    "lib",
    "*.test.ts"
  ]
}
